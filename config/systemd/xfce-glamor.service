[Unit]
Description=Xfce desktop on tty1 with glamor (GPU-accelerated X on Xenos)
After=multi-user.target systemd-user-sessions.service xegpu.service
Conflicts=getty@tty1.service xfce-tty1.service

[Service]
ExecStartPre=/opt/deqp/gl-ready.sh
ExecStartPre=/bin/sh -c 'echo 0 > /sys/module/xegpu/parameters/gpu_blit'
ExecStart=/usr/bin/xinit /usr/bin/startxfce4 -- /usr/bin/Xorg :0 vt1 -nolisten tcp -keeptty -configdir /etc/X11/glamor-test -modulepath /opt/xegpu-xorg/modules,/usr/lib/xorg/modules -logfile /tmp/Xxfce.log
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
RuntimeDirectory=xfce
RuntimeDirectoryMode=0700
Environment=HOME=/root XDG_RUNTIME_DIR=/run/xfce PIXMAN_DISABLE=vmx LD_LIBRARY_PATH=/opt/mesa-xenos/lib
