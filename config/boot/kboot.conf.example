#KBOOTCONFIG
# Served by insight (<host-ip>). The copy on the USB stick root is what Xell reads first;
# keep the two in sync (the USB copy is updated over Aurora FTP at Usb0:\kboot.conf).
tftp_server=<host-ip>
timeout=20
default=debian
speedup=1
linux="vmlinux console=tty0 panic=30 maxcpus=6 coherent_pool=16M video=xenosfb initrd=initrd.gz"
debian="vmlinux root=/dev/nfs nfsroot=<host-ip>:/srv/nfs/xenon,vers=3,tcp,nolock ip=dhcp rw console=tty0 panic=30 maxcpus=6 coherent_pool=16M video=xenosfb"
debian-old="vmlinux-prealtivec root=/dev/nfs nfsroot=<host-ip>:/srv/nfs/xenon,vers=3,tcp,nolock ip=dhcp rw console=tty0 panic=30 maxcpus=6 coherent_pool=16M video=xenosfb"
