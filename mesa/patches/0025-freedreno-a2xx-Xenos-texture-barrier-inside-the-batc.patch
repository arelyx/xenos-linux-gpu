+/* Xenos texture barrier without ending the batch. A Xenos batch renders as one
+ * bin, so its draw commands run once, in order: resolving the color buffer's
+ * dirty area in the middle of them makes the earlier draws visible to later
+ * texture fetches (draws already invalidate the texture cache). glamor calls
+ * glTextureBarrierNV before every copy within a pixmap, which otherwise costs
+ * a whole batch (restore, resolve, submit) per copy.
+ */
+void
+fd2_xenos_texture_barrier(struct pipe_context *pctx, unsigned flags) in_dt
+{
+   struct fd_context *ctx = fd_context(pctx);
+   struct fd2_context *fd2_ctx = fd2_context(ctx);
+   struct fd_batch *batch = ctx->batch;
+   struct pipe_framebuffer_state *pfb;
+   struct fd_ringbuffer *ring;
+   unsigned rx0, ry0, rx1, ry1;
+
+   if (!batch || getenv("XENOS_FLUSH_BARRIER")) {
+      pctx->flush(pctx, NULL, 0);
+      return;
+   }
+   pfb = &batch->framebuffer;
+   /* nothing drawn since the last barrier (earlier batches are flushed by
+    * resource tracking when a draw reads what they wrote) */
+   if (batch->barrier_scissor.minx > batch->barrier_scissor.maxx ||
+       batch->barrier_scissor.miny > batch->barrier_scissor.maxy)
+      return;
+   if (pfb->nr_cbufs != 1 || !pfb->cbufs[0].texture || pfb->zsbuf.texture ||
+       batch->nondraw) {
+      pctx->flush(pctx, NULL, 0);
+      return;
+   }
+
+   fd_batch_needs_flush(batch);
+   ring = batch->draw;
+   /* only what was drawn since the last barrier */
+   xenos_scissor_rect(batch, &batch->barrier_scissor, &rx0, &ry0, &rx1, &ry1);
+   batch->barrier_scissor.minx = batch->barrier_scissor.miny = ~0;
+   batch->barrier_scissor.maxx = batch->barrier_scissor.maxy = 0;
+
+   fd2_emit_vertex_bufs(ring, 0x9c,
+                        (struct fd2_vertex_buf[]){
+                           {.prsc = fd2_ctx->solid_vertexbuf, .size = 36},
+                        },
+                        1);
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_PA_SC_WINDOW_OFFSET));
+   OUT_RING(ring, 0x00000000);
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_VGT_INDX_OFFSET));
+   OUT_RING(ring, 0);
+   fd2_program_emit(ctx, ring, &ctx->solid_prog);
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_PA_SC_AA_MASK));
+   OUT_RING(ring, 0x0000ffff);
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_RB_DEPTHCONTROL));
+   OUT_RING(ring, A2XX_RB_DEPTHCONTROL_EARLY_Z_ENABLE);
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_PA_SU_SC_MODE_CNTL));
+   OUT_RING(ring, A2XX_PA_SU_SC_MODE_CNTL_PROVOKING_VTX_LAST |
+                     A2XX_PA_SU_SC_MODE_CNTL_FRONT_PTYPE(PC_DRAW_TRIANGLES) |
+                     A2XX_PA_SU_SC_MODE_CNTL_BACK_PTYPE(PC_DRAW_TRIANGLES));
+   OUT_PKT3(ring, CP_SET_CONSTANT, 3);
+   OUT_RING(ring, CP_REG(REG_A2XX_PA_SC_WINDOW_SCISSOR_TL));
+   OUT_RING(ring, xy2d(rx0, ry0));
+   OUT_RING(ring, xy2d(rx1, ry1));
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_PA_CL_CLIP_CNTL));
+   OUT_RING(ring, 0x00000000);
+   OUT_PKT3(ring, CP_SET_CONSTANT, 5);
+   OUT_RING(ring, CP_REG(REG_A2XX_PA_CL_VPORT_XSCALE));
+   OUT_RING(ring, fui((rx1 - rx0) / 2.0f));
+   OUT_RING(ring, fui(rx0 + (rx1 - rx0) / 2.0f));
+   OUT_RING(ring, fui((ry1 - ry0) / 2.0f));
+   OUT_RING(ring, fui(ry0 + (ry1 - ry0) / 2.0f));
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_RB_MODECONTROL));
+   OUT_RING(ring, A2XX_RB_MODECONTROL_EDRAM_MODE(EDRAM_COPY));
+
+   /* the only color buffer of a batch without depth is at EDRAM offset 0 */
+   emit_gmem2mem_surf(batch, ring, 0, &pfb->cbufs[0]);
+
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_RB_MODECONTROL));
+   OUT_RING(ring, A2XX_RB_MODECONTROL_EDRAM_MODE(COLOR_DEPTH));
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_RB_COPY_CONTROL));
+   OUT_RING(ring, 0x00000000);
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_RB_COLOR_INFO));
+   OUT_RING(ring, xenos_rb_color_info(0));
+
+   fd_context_all_dirty(ctx);
+}
