+
+/* Xbox 360 Xenos: resolves always write the GPU's 2D tiled layout and textures
+ * are fetched tiled, so CPU access to a tiled resource (de)tiles here instead of
+ * going through a GPU staging blit (which would resolve tiled data into the
+ * "linear" staging buffer). XGAddress2DTiledOffset, as in libxenon/Xenia;
+ * returns a texel index. */
+static inline uint32_t
+xenos_tiled_texel(uint32_t x, uint32_t y, uint32_t pitch_px, uint32_t cpp)
+{
+   uint32_t aw = (pitch_px + 31) & ~31u;
+   uint32_t lb = (cpp >> 2) + ((cpp >> 1) >> (cpp >> 2));
+   uint32_t macro = ((x >> 5) + (y >> 5) * (aw >> 5)) << (lb + 7);
+   uint32_t micro = ((x & 7) + ((y & 6) << 2)) << lb;
+   uint32_t off = macro + ((micro & ~15u) << 1) + (micro & 15) + ((y & 8) << (3 + lb)) + ((y & 1) << 4);
+   return (((off & ~511u) << 3) + ((off & 448) << 2) + (off & 63) + ((y & 16) << 7) +
+           (((((y & 8) >> 2) + (x >> 3)) & 3) << 6)) >> lb;
+}
+
+static void
+xenos_tile_copy(struct fd_resource *rsc, unsigned level, const struct pipe_box *box,
+                uint8_t *linear, unsigned stride, bool to_linear)
+{
+   uint8_t *tiled = (uint8_t *)fd_bo_map(rsc->bo) + fd_resource_offset(rsc, level, box->z);
+   unsigned cpp = rsc->layout.cpp;
+   unsigned pitch_px = fd_resource_pitch(rsc, level) / cpp;
+   for (int y = 0; y < box->height; y++) {
+      for (int x = 0; x < box->width; x++) {
+         uint8_t *t = tiled + (size_t)xenos_tiled_texel(box->x + x, box->y + y, pitch_px, cpp) * cpp;
+         uint8_t *l = linear + (size_t)y * stride + (size_t)x * cpp;
+         if (to_linear)
+            memcpy(l, t, cpp);
+         else
+            memcpy(t, l, cpp);
+      }
+   }
+}
+
+static void *
+resource_transfer_map_xenos(struct pipe_context *pctx, struct pipe_resource *prsc,
+                            unsigned level, unsigned usage, const struct pipe_box *box,
+                            struct fd_transfer *trans) assert_dt
+{
+   struct fd_context *ctx = fd_context(pctx);
+   struct fd_resource *rsc = fd_resource(prsc);
+   unsigned stride = box->width * rsc->layout.cpp;
+
+   if (pending(rsc, !!(usage & PIPE_MAP_WRITE)))
+      flush_resource(ctx, rsc, usage);
+   fd_resource_wait(ctx, rsc, translate_usage(usage));
+
+   if (getenv("XENOS_DEBUG"))
+      fprintf(stderr, "xenos map %p %ux%u+%u,%u level %u usage %x cpp %u pitch %u\n", (void *)rsc,
+              box->width, box->height, box->x, box->y, level, usage, rsc->layout.cpp, fd_resource_pitch(rsc, level));
+   trans->xenos_linear = malloc((size_t)stride * box->height);
+   if (!trans->xenos_linear)
+      return NULL;
+   trans->b.b.stride = stride;
+   trans->b.b.layer_stride = stride * box->height;
+   if (usage & PIPE_MAP_READ)
+      xenos_tile_copy(rsc, level, box, trans->xenos_linear, stride, true);
+   if (usage & PIPE_MAP_WRITE)
+      rsc->valid = true;
+   return trans->xenos_linear;
+}
