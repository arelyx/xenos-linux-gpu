@@ -53,7 +53,13 @@ fd_draw(struct fd_batch *batch, struct fd_ringbuffer *ring,
       OUT_RING(ring, 0);
    }
 
-   if (is_a20x(batch->ctx->screen)) {
+   if (is_xenos(batch->ctx->screen)) {
+      /* Xenos uses the a20x-style initiator: the index count lives in bits
+       * 31:16 (libxenon, Xenia VGT_DRAW_INITIATOR); no visibility/binning */
+      vismode = IGNORE_VISIBILITY;
+   }
