@@ -125,6 +125,16 @@ emit_constants(struct fd_context *ctx, struct fd_ringbuffer *ring, uint32_t base
    }
 }
 
+/* RB_BLEND_CONTROL for the bound color buffer */
+static uint32_t
+fd2_blend_control(struct fd_context *ctx, struct fd2_blend_stateobj *blend)
+{
+   struct pipe_surface *cb = &ctx->batch->framebuffer.cbufs[0];
+   if (fd2_xenos && cb->texture && !util_format_has_alpha(cb->format))
+      return blend->rb_blendcontrol_noalpha;
+   return blend->rb_blendcontrol;
+}
+
 typedef uint32_t texmask;
 
 static texmask
@@ -285,7 +295,7 @@ fd2_emit_state_binning(struct fd_context *ctx,
    if (dirty & (FD_DIRTY_BLEND | FD_DIRTY_FRAMEBUFFER)) {
       OUT_PKT3(ring, CP_SET_CONSTANT, 2);
       OUT_RING(ring, CP_REG(REG_A2XX_RB_BLEND_CONTROL));
-      OUT_RING(ring, blend->rb_blendcontrol);
+      OUT_RING(ring, fd2_blend_control(ctx, blend));
 
       OUT_PKT3(ring, CP_SET_CONSTANT, 2);
       OUT_RING(ring, CP_REG(REG_A2XX_RB_COLOR_MASK));
@@ -478,7 +488,7 @@ fd2_emit_state(struct fd_context *ctx, const enum fd_dirty_3d_state dirty)
    if (dirty & (FD_DIRTY_BLEND | FD_DIRTY_FRAMEBUFFER)) {
       OUT_PKT3(ring, CP_SET_CONSTANT, 2);
       OUT_RING(ring, CP_REG(REG_A2XX_RB_BLEND_CONTROL));
-      OUT_RING(ring, blend->rb_blendcontrol);
+      OUT_RING(ring, fd2_blend_control(ctx, blend));
 
