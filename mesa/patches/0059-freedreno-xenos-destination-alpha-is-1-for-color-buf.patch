---
 .../drivers/freedreno/a2xx/fd2_blend.c        | 23 ++++++++++++++++++-
 .../drivers/freedreno/a2xx/fd2_blend.h        |  1 +
 src/gallium/drivers/freedreno/a2xx/fd2_emit.c | 14 +++++++++--
 3 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_blend.c b/src/gallium/drivers/freedreno/a2xx/fd2_blend.c
index 38bd9a5..4b4457a 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_blend.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_blend.c
@@ -78,6 +78,27 @@ fd2_blend_state_create(struct pipe_context *pctx,
       A2XX_RB_BLEND_CONTROL_ALPHA_DESTBLEND(
          fd_blend_factor(rt->alpha_dst_factor));
 
+   /* a color buffer without alpha reads destination alpha as 1 (piglit
+    * fbo-blending-formats: Xenos read the X channel) */
+   {
+      unsigned f[4] = {rt->rgb_src_factor, rt->rgb_dst_factor, alpha_src_factor, rt->alpha_dst_factor};
+      for (unsigned k = 0; k < 4; k++) {
+         if (f[k] == PIPE_BLENDFACTOR_DST_ALPHA)
+            f[k] = PIPE_BLENDFACTOR_ONE;
+         else if (f[k] == PIPE_BLENDFACTOR_INV_DST_ALPHA)
+            f[k] = PIPE_BLENDFACTOR_ZERO;
+         else if (f[k] == PIPE_BLENDFACTOR_SRC_ALPHA_SATURATE && k < 2)
+            f[k] = PIPE_BLENDFACTOR_ZERO;   /* min(As, 1 - 1) */
+      }
+      so->rb_blendcontrol_noalpha =
+         A2XX_RB_BLEND_CONTROL_COLOR_SRCBLEND(fd_blend_factor(f[0])) |
+         A2XX_RB_BLEND_CONTROL_COLOR_COMB_FCN(blend_func(rt->rgb_func)) |
+         A2XX_RB_BLEND_CONTROL_COLOR_DESTBLEND(fd_blend_factor(f[1])) |
+         A2XX_RB_BLEND_CONTROL_ALPHA_SRCBLEND(fd_blend_factor(f[2])) |
+         A2XX_RB_BLEND_CONTROL_ALPHA_COMB_FCN(blend_func(rt->alpha_func)) |
+         A2XX_RB_BLEND_CONTROL_ALPHA_DESTBLEND(fd_blend_factor(f[3]));
+   }
+
    if (rt->colormask & PIPE_MASK_R)
       so->rb_colormask |= A2XX_RB_COLOR_MASK_WRITE_RED;
    if (rt->colormask & PIPE_MASK_G)
@@ -92,7 +113,7 @@ fd2_blend_state_create(struct pipe_context *pctx,
       /* Xenos has no BLEND_DISABLE bit (pad in RB_COLORCONTROL): "disabled"
        * is src ONE, dst ZERO, as libxenon programs it */
       if (is_xenos(fd_context(pctx)->screen))
-         so->rb_blendcontrol = 0x00010001;
+         so->rb_blendcontrol = so->rb_blendcontrol_noalpha = 0x00010001;
    }
 
    if (cso->dither)
diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_blend.h b/src/gallium/drivers/freedreno/a2xx/fd2_blend.h
index 998103c..5df4bc5 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_blend.h
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_blend.h
@@ -15,6 +15,7 @@
 struct fd2_blend_stateobj {
    struct pipe_blend_state base;
    uint32_t rb_blendcontrol;
+   uint32_t rb_blendcontrol_noalpha;   /* for color buffers without alpha */
    uint32_t rb_colorcontrol; /* must be OR'd w/ zsa->rb_colorcontrol */
    uint32_t rb_colormask;
 };
diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_emit.c b/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
