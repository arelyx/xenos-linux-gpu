+        GPUId(gpu_id=290, chip_id=0x02090000, name="Xenos"),
+    ], GPUInfo(
+        CHIP.A2XX,
+        gmem_align_w = 160, gmem_align_h = 16,
+        tile_align_w = 160, tile_align_h = 16,
+        tile_max_w   = 2560,
