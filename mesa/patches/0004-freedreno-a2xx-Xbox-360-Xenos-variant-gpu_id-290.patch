+                                     : fd2_pipe2color(format) != (enum a2xx_colorformatx) ~0)) {
       retval |= usage & (PIPE_BIND_RENDER_TARGET | PIPE_BIND_DISPLAY_TARGET |
                          PIPE_BIND_SCANOUT | PIPE_BIND_SHARED);
    }
 
    if ((usage & PIPE_BIND_DEPTH_STENCIL) &&
-       (fd_pipe2depth(format) != (enum adreno_rb_depth_format) ~0)) {
+       (fd_pipe2depth(format) != (enum adreno_rb_depth_format) ~0) &&
+       (!is_xenos(fd_screen(pscreen)) || xenos_depth_format_ok(format))) {
       retval |= PIPE_BIND_DEPTH_STENCIL;
    }
 
diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h b/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h
new file mode 100644
index 0000000..f3d2d89
--- /dev/null
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h
@@ -0,0 +1,113 @@
+/*
+ * Xbox 360 Xenos render-target and resolve register encodings.
+ * Field layouts from Xenia (src/xenia/gpu/registers.h); behaviour checked against libxenon.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef FD2_XENOS_H_
+#define FD2_XENOS_H_
+
+#include "util/format/u_format.h"
+
+/* EDRAM tile: 80x16 samples at 32bpp */
+#define XENOS_EDRAM_TILE_BYTES 5120
+
+/* RB_SURFACE_INFO: surface_pitch (pixels) [13:0], msaa_samples [17:16], hiz_pitch [31:18] */
+static inline uint32_t
+xenos_rb_surface_info(uint32_t pitch)
+{
+   return pitch & 0x3fff;
+}
+
+/* RB_COLOR_INFO: color_base (tiles) [11:0], color_format [19:16] (k_8_8_8_8 = 0) */
+static inline uint32_t
+xenos_rb_color_info(uint32_t gmem_base_bytes)
+{
+   return (gmem_base_bytes / XENOS_EDRAM_TILE_BYTES) & 0xfff;
+}
+
+/* RB_DEPTH_INFO: depth_base (tiles) [11:0], depth_format [16] (0 = D24S8) */
+static inline uint32_t
+xenos_rb_depth_info(uint32_t gmem_base_bytes)
+{
+   return (gmem_base_bytes / XENOS_EDRAM_TILE_BYTES) & 0xfff;
+}
+
+/* RB_COPY_CONTROL: copy_src_select [2:0] (0..3 color RT, 4 depth), copy_sample_select [6:4],
+ * color_clear [8], depth_clear [9], copy_command [21:20] (1 = convert, as libxenon uses) */
+static inline uint32_t
+xenos_rb_copy_control(bool depth)
+{
+   return (depth ? 4 : 0) | (1u << 20);
+}
+
+/* RB_COPY_DEST_PITCH: pitch (pixels) [13:0], height [29:16] */
+static inline uint32_t
+xenos_rb_copy_dest_pitch(uint32_t pitch, uint32_t height)
+{
+   return (pitch & 0x3fff) | ((height & 0x3fff) << 16);
+}
+
+/* RB_COPY_DEST_INFO: endian [2:0], array [3], slice [6:4], format [12:7] (texture format
+ * enum, k_8_8_8_8 = 6), number [15:13], exp_bias [21:16], swap [24].
+ * Byte order stored, measured on hardware with libxenon resolves:
+ *   endian 0, swap 1: R,G,B,A    endian 0, swap 0: B,G,R,A
+ *   endian 2 (8in32), swap 1: A,B,G,R    endian 2, swap 0: A,R,G,B */
+static inline uint32_t
+xenos_rb_copy_dest_info(enum pipe_format format)
+{
+   uint32_t endian = 0, swap = 0;
+   switch (format) {
+   case PIPE_FORMAT_R8G8B8A8_UNORM: case PIPE_FORMAT_R8G8B8X8_UNORM: swap = 1; break;
+   case PIPE_FORMAT_B8G8R8A8_UNORM: case PIPE_FORMAT_B8G8R8X8_UNORM: break;
+   case PIPE_FORMAT_A8B8G8R8_UNORM: case PIPE_FORMAT_X8B8G8R8_UNORM: endian = 2; swap = 1; break;
+   case PIPE_FORMAT_A8R8G8B8_UNORM: case PIPE_FORMAT_X8R8G8B8_UNORM: endian = 2; break;
+   default: break;
+   }
+   return endian | (6u << 7) | (swap << 24);
+}
+
+static inline bool
+xenos_color_format_ok(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_B8G8R8A8_UNORM:
+   case PIPE_FORMAT_B8G8R8X8_UNORM:
+   case PIPE_FORMAT_R8G8B8A8_UNORM:
+   case PIPE_FORMAT_R8G8B8X8_UNORM:
+   case PIPE_FORMAT_A8B8G8R8_UNORM:
+   case PIPE_FORMAT_X8B8G8R8_UNORM:
+   case PIPE_FORMAT_A8R8G8B8_UNORM:
+   case PIPE_FORMAT_X8R8G8B8_UNORM:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static inline bool
+xenos_depth_format_ok(enum pipe_format format)
+{
+   return format == PIPE_FORMAT_Z24_UNORM_S8_UINT || format == PIPE_FORMAT_Z24X8_UNORM;
+}
+
+/* Texture/vertex cache invalidate over all of DRAM, as libxenon's Xe_pInvalidateGpuCache:
+ * COHER_STATUS_HOST request, COHER_SIZE/BASE_HOST, then wait for the status bit to clear.
+ * (Xenos has no a2xx TC_CNTL_STATUS at 0x0e00.) */
+#define XENOS_REG_COHER_SIZE_HOST   0x0a2f
+#define XENOS_REG_COHER_STATUS_HOST 0x0a31
+#define fd2_xenos_invalidate_caches(ring)                                      \
+   do {                                                                        \
+      OUT_PKT0(ring, XENOS_REG_COHER_STATUS_HOST, 1);                          \
+      OUT_RING(ring, 0x01000000);                                              \
+      OUT_PKT0(ring, XENOS_REG_COHER_SIZE_HOST, 2);                            \
+      OUT_RING(ring, 0x20000000); /* size: all of DRAM */                      \
+      OUT_RING(ring, 0x00000000); /* base */                                   \
+      OUT_PKT3(ring, CP_WAIT_REG_MEM, 5);                                      \
+      OUT_RING(ring, 0x00000003);                                              \
+      OUT_RING(ring, XENOS_REG_COHER_STATUS_HOST);                             \
+      OUT_RING(ring, 0x00000000);                                              \
+      OUT_RING(ring, 0x80000000);                                              \
+      OUT_RING(ring, 0x00000008);                                              \
+   } while (0)
+
+#endif
