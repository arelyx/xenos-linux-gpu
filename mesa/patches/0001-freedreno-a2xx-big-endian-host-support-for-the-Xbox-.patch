From 61c1b3e7b1cdb3574815633e6d0b2e2d364de8c2 Mon Sep 17 00:00:00 2001
From: xenos <xenos@localhost>
Date: Sun, 25 Oct 2026 13:51:01 -0700
Subject: [PATCH 01/22] freedreno/a2xx: big-endian host support for the Xbox
 360 (Xenos)

Lay out the a2xx instruction bitfield structs in little-endian storage order on
big-endian hosts (verified byte-identical to x86 for ALU, CF and fetch), swap
shader words when emitting them into the command stream, and disable hw binning
on big-endian hosts (it patches emitted CFs in place).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Generated-by: LLM
---
 src/freedreno/ir2/instr-a2xx.h                   | 14 +++++++++++---
 src/gallium/drivers/freedreno/a2xx/fd2_gmem.c    |  5 +++++
 src/gallium/drivers/freedreno/a2xx/fd2_program.c |  5 ++++-
 3 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/src/freedreno/ir2/instr-a2xx.h b/src/freedreno/ir2/instr-a2xx.h
index 1bbbe88..feb3d44 100644
--- a/src/freedreno/ir2/instr-a2xx.h
+++ b/src/freedreno/ir2/instr-a2xx.h
@@ -6,7 +6,15 @@
 #ifndef INSTR_A2XX_H_
 #define INSTR_A2XX_H_
 
+/* The hardware encodings are defined as little-endian bitfields. On a
+ * big-endian host (the Xbox 360's Xenon), lay the structs out as a
+ * little-endian compiler would, so their bytes are the same image.
+ */
+#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define PACKED __attribute__((__packed__, scalar_storage_order("little-endian")))
+#else
 #define PACKED __attribute__((__packed__))
+#endif
 
 #include "fd2_hw.h"
 
@@ -127,8 +135,8 @@ typedef struct PACKED {
    uint8_t const_1_rel_abs : 1;
    uint8_t const_0_rel_abs : 1;
    /* dword2: */
-   union {
-      struct {
+   union PACKED {
+      struct PACKED {
          uint8_t src3_reg : 6;
          uint8_t src3_reg_select : 1;
          uint8_t src3_reg_abs : 1;
@@ -140,7 +148,7 @@ typedef struct PACKED {
          uint8_t src1_reg_abs : 1;
       };
       /* constants have full 8-bit index */
-      struct {
+      struct PACKED {
          uint8_t src3_reg_byte : 8;
          uint8_t src2_reg_byte : 8;
          uint8_t src1_reg_byte : 8;
diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c b/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
index 7d9db5e..91a339b 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
@@ -20,6 +20,7 @@
 #include "fd2_draw.h"
 #include "fd2_emit.h"
 #include "fd2_gmem.h"
+#include "util/u_endian.h"
 #include "fd2_program.h"
 #include "fd2_util.h"
 #include "fd2_zsa.h"
@@ -61,6 +62,10 @@ use_hw_binning(struct fd_batch *batch)
    if (!is_a20x(batch->ctx->screen))
       return false;
 
+   /* hw binning patches emitted shader CFs in place, which assumes host byte order
+    * equals the shader image; not handled for big-endian hosts yet */
+   if (UTIL_ARCH_BIG_ENDIAN)
+      return false;
    return fd_binning_enabled && ((gmem->nbins_x * gmem->nbins_y) > 2);
 }
 
diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_program.c b/src/gallium/drivers/freedreno/a2xx/fd2_program.c
index cecfc07..de52e93 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_program.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_program.c
@@ -20,6 +20,8 @@
 #include "ir2/instr-a2xx.h"
 #include "fd2_context.h"
 #include "fd2_program.h"
+#include "util/u_endian.h"
+#include "util/u_math.h"
 #include "fd2_texture.h"
 #include "fd2_util.h"
 #include "ir2.h"
@@ -53,7 +55,8 @@ emit(struct fd_ringbuffer *ring, mesa_shader_stage type,
    }
 
    for (i = 0; i < info->sizedwords; i++)
-      OUT_RING(ring, info->dwords[i]);
+      /* shader words are little-endian byte images; the CP reads native words */
+      OUT_RING(ring, UTIL_ARCH_BIG_ENDIAN ? util_bswap32(info->dwords[i]) : info->dwords[i]);
 }
 
 static unsigned
