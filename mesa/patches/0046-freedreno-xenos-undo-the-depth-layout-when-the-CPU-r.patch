---
 .../drivers/freedreno/freedreno_resource.c    | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/gallium/drivers/freedreno/freedreno_resource.c b/src/gallium/drivers/freedreno/freedreno_resource.c
index 74f9ebd..17d863c 100644
--- a/src/gallium/drivers/freedreno/freedreno_resource.c
+++ b/src/gallium/drivers/freedreno/freedreno_resource.c
@@ -824,6 +824,27 @@ xenos_tile_copy(struct fd_resource *rsc, unsigned level, const struct pipe_box *
    uint8_t *tiled = (uint8_t *)fd_bo_map(rsc->bo) + fd_resource_offset(rsc, level, box->z);
    unsigned cpp = rsc->layout.cpp;
    unsigned pitch_px = fd_resource_pitch(rsc, level) / cpp;
+
+   /* Depth/stencil reaches memory through the color path (fd2_gmem.c): within
+    * each 80-pixel EDRAM tile the 40-pixel halves are swapped, and each word
+    * is Mesa's Z24S8 byte-swapped and rotated left by 8 (hardware rule 28).
+    * Reads undo that. Writes stay as they are: depth textures the CPU uploads
+    * are sampled, and the texture unit reads them in Mesa's layout. */
+   if (util_format_is_depth_or_stencil(rsc->b.b.format) && cpp == 4 && to_linear) {
+      for (int y = 0; y < box->height; y++) {
+         for (int x = 0; x < box->width; x++) {
+            unsigned px = box->x + x;
+            unsigned sx = px / 80 * 80 + (px % 80 + 40) % 80;
+            if (sx >= pitch_px)   /* swapped half past the end of the row: not resolved */
+               sx = px;
+            uint32_t *t = (uint32_t *)(tiled + (size_t)xenos_tiled_texel(sx, box->y + y, pitch_px, cpp) * cpp);
+            uint32_t *l = (uint32_t *)(linear + (size_t)y * stride + (size_t)x * cpp);
+            uint32_t v = __builtin_bswap32(*t);
+            *l = (v >> 8) | (v << 24);
+         }
+      }
+      return;
+   }
    /* texels are contiguous in runs of 16 bytes (8 for 1-byte texels), aligned in x */
    unsigned run = cpp == 1 ? 8 : MAX2(1, 16 / cpp);
    for (int y = 0; y < box->height; y++) {
