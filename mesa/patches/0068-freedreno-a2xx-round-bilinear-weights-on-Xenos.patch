    struct {
diff --git a/src/gallium/drivers/freedreno/a2xx/ir2_nir.c b/src/gallium/drivers/freedreno/a2xx/ir2_nir.c
index ee1dbed..b74c6c7 100644
--- a/src/gallium/drivers/freedreno/a2xx/ir2_nir.c
+++ b/src/gallium/drivers/freedreno/a2xx/ir2_nir.c
@@ -141,6 +141,34 @@ ir2_lower_tex_shadow(nir_builder *b, nir_tex_instr *tex, void *data)
    return true;
 }
 
+/* Xenos truncates bilinear weights to 1/64: a coordinate at a texel center
+ * plus a rounding error picks up 1/64 of the neighbor, 4/255 off for 8-bit
+ * colors (piglit 1-1-linear-texture, fbo-blit-stretch). Adding half a step
+ * (1/128 texel of the base level, from IR2_TEXROUND_CONST + sampler, zero for
+ * nearest filtering) makes the truncation round. */
+static bool
+ir2_lower_tex_round(nir_builder *b, nir_tex_instr *tex, void *data)
+{
+   if ((tex->op != nir_texop_tex && tex->op != nir_texop_txb &&
+        tex->op != nir_texop_txl && tex->op != nir_texop_txd) ||
+       nir_tex_instr_src_index(tex, nir_tex_src_comparator) >= 0 ||
+       tex->is_array || tex->sampler_index >= 12 ||
+       (tex->sampler_dim != GLSL_SAMPLER_DIM_1D && tex->sampler_dim != GLSL_SAMPLER_DIM_2D &&
+        tex->sampler_dim != GLSL_SAMPLER_DIM_3D && tex->sampler_dim != GLSL_SAMPLER_DIM_RECT))
+      return false;
+
+   int c = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+   if (c < 0)
+      return false;
+   b->cursor = nir_before_instr(&tex->instr);
+   nir_def *coord = tex->src[c].src.ssa;
+   nir_def *off = nir_load_uniform(b, 4, 32, nir_imm_int(b, 0),
+                                   .base = IR2_TEXROUND_CONST + tex->sampler_index);
+   off = nir_trim_vector(b, off, coord->num_components);
+   nir_src_rewrite(&tex->src[c].src, nir_fadd(b, coord, off));
+   return true;
+}
