---
 src/gallium/drivers/freedreno/a2xx/fd2_resource.c  | 12 +++++++++++-
 src/gallium/drivers/freedreno/freedreno_resource.c |  5 +++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_resource.c b/src/gallium/drivers/freedreno/a2xx/fd2_resource.c
index 3f709b1..f6933c3 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_resource.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_resource.c
@@ -7,6 +7,7 @@
  */
 
 #include "fd2_resource.h"
+#include "fd2_emit.h"
 #include "freedreno_screen.h"
 
 uint32_t
@@ -48,8 +49,17 @@ fd2_tile_mode(const struct pipe_resource *tmpl)
    /* disable tiling for cube maps, freedreno uses a 2D array for the staging
     * texture, (a2xx supports 2D arrays but it is not implemented)
     */
-   if (tmpl->target == PIPE_TEXTURE_CUBE)
+   if (tmpl->target == PIPE_TEXTURE_CUBE && !fd2_xenos)
       return 0;
+   /* Xenos: cube faces are (de)tiled on the CPU like 2D textures, and the
+    * linear layout's mip pitches didn't match what the sampler reads (POT
+    * cubes with mipmaps failed in dEQP) */
+   /* Xenos: textures too. Its linear layout aligns mip rows to 256 bytes
+    * (Xenia texture_util), unlike this one; the tiled layout matches. */
+   if (fd2_xenos && (tmpl->bind & PIPE_BIND_SAMPLER_VIEW) && tmpl->usage != PIPE_USAGE_STAGING &&
+       (tmpl->target == PIPE_TEXTURE_2D || tmpl->target == PIPE_TEXTURE_CUBE) &&
+       !util_format_is_compressed(tmpl->format))
+      return 1;
    /* we can enable tiling for any resource we can render to */
    return (tmpl->bind & PIPE_BIND_RENDER_TARGET) ? 1 : 0;
 }
diff --git a/src/gallium/drivers/freedreno/freedreno_resource.c b/src/gallium/drivers/freedreno/freedreno_resource.c
index 65ae4ca..f612c9c 100644
--- a/src/gallium/drivers/freedreno/freedreno_resource.c
+++ b/src/gallium/drivers/freedreno/freedreno_resource.c
@@ -1417,6 +1417,11 @@ get_best_layout(struct fd_screen *screen,
    if (is_xenos(screen) && (tmpl->bind & PIPE_BIND_RENDER_TARGET) &&
        tmpl->target != PIPE_BUFFER)
       return FD_LAYOUT_TILED;
+   /* and textures (fd2_tile_mode) */
+   if (is_xenos(screen) && (tmpl->bind & PIPE_BIND_SAMPLER_VIEW) && tmpl->usage != PIPE_USAGE_STAGING &&
+       (tmpl->target == PIPE_TEXTURE_2D || tmpl->target == PIPE_TEXTURE_CUBE) &&
+       !util_format_is_compressed(tmpl->format))
+      return FD_LAYOUT_TILED;
 
    if ((tmpl->target == PIPE_BUFFER) ||
        (tmpl->target == PIPE_TEXTURE_1D) ||
