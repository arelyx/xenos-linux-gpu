+
+bool fd2_xenos;   /* set by fd2_screen_init on Xbox 360 */
+
+/* Pad with type-2 NOPs until the next dword is at (dword offset % 4) == rem.
+ * libxenon (Xe_pAlign) starts all constant data 16-byte aligned. Ring chunks
+ * are at least 64-byte aligned, so the offset inside the ring is enough. */
+void
+fd2_xenos_align(struct fd_ringbuffer *ring, unsigned rem)
+{
+   while (((ring->cur - ring->start) & 3) != rem)
+      OUT_RING(ring, 0x80000000);
+}
+
+/* ALU constants: SET_CONSTANT on Adreno; on Xenos whole 64-dword blocks from
+ * the context shadow, written with type-0 packets to 0x4000+ as libxenon does. */
+void
+fd2_emit_alu_consts(struct fd_context *ctx, struct fd_ringbuffer *ring,
+                    uint32_t base, const uint32_t *vals, unsigned n)
+{
+   if (!is_xenos(ctx->screen)) {
+      OUT_PKT3(ring, CP_SET_CONSTANT, n + 1);
+      OUT_RING(ring, base);
+      for (unsigned i = 0; i < n; i++)
+         OUT_RING(ring, vals[i]);
+      return;
+   }
+   uint32_t *sh = fd2_context(ctx)->xenos_alu;
+   assert(base + n <= 2048);
+   memcpy(sh + base, vals, n * 4);
+   unsigned b0 = base & ~63u, b1 = align(base + n, 64);
+   fd2_xenos_align(ring, 3);
+   OUT_PKT0(ring, 0x4000 + b0, b1 - b0);
+   for (unsigned i = b0; i < b1; i++)
+      OUT_RING(ring, sh[i]);
+}
