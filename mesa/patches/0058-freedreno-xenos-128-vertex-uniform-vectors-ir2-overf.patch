    instr_t bytecode[IR2_MAX_SCHED], bc;
-   unsigned block_addr[128];
+   unsigned block_addr[IR2_MAX_SCHED + 1];   /* one per block; 128 overflowed (dEQP uniform_api.random.3) */
    unsigned num_cf = 0;
 
    /* CF instr state */
@@ -472,8 +472,10 @@ assemble(struct ir2_context *ctx, bool binning)
       }
 
