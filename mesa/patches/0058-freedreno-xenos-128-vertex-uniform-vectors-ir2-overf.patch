                              fui(vp->scale[0]), fui(vp->scale[1]), fui(vp->scale[2]), fui(0.0f) };
-         fd2_emit_alu_consts(ctx, ring, 0x184, vpc, 8);
+         fd2_emit_alu_consts(ctx, ring, fd2_xenos ? (VS_CONST_BASE + 254) * 4 : 0x184, vpc, 8);
       }
