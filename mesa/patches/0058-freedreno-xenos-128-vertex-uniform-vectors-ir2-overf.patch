    if (ctx->f->fragcoord >= 0 && !binning) {
diff --git a/src/gallium/drivers/freedreno/freedreno_screen.c b/src/gallium/drivers/freedreno/freedreno_screen.c
index ef6d24b..a7fef5a 100644
--- a/src/gallium/drivers/freedreno/freedreno_screen.c
+++ b/src/gallium/drivers/freedreno/freedreno_screen.c
@@ -266,6 +266,13 @@ fd_init_shader_caps(struct fd_screen *screen)
        */
       caps->max_const_buffer0_size =
          (is_a3xx(screen) || is_a4xx(screen) || is_a5xx(screen) || is_a6xx(screen) ? 4096 : 64) * sizeof(float[4]);
+      /* Xenos: each stage has 256 constant registers (pixel shader from
+       * 0x120, of which IR2_SHADOW_CONST.. are the driver's); uniforms plus
+       * up to 64 immediates must fit. GL 2.0 wants 128 vertex uniform
+       * vectors (and ARB_vertex_program 96 parameters: piglit vp-max-array) */
+      if (is_xenos(screen))
+         caps->max_const_buffer0_size =
+            (i == MESA_SHADER_VERTEX ? 128 : 112) * sizeof(float[4]);
 
       caps->max_const_buffers = is_ir3(screen) ? 16 : 1;
 
