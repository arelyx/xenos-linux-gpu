 src/gallium/drivers/freedreno/a2xx/fd2_screen.c  |  5 ++++-
 src/gallium/drivers/freedreno/a2xx/fd2_xenos.h   | 14 ++++++++++++--
 src/gallium/drivers/freedreno/freedreno_draw.h   |  4 ++++
