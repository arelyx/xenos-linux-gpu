+      fprintf(stderr, "xenos layout %s %ux%u bind %x usage %u\n", util_format_short_name(tmpl->format),
+              tmpl->width0, tmpl->height0, tmpl->bind, tmpl->usage);
    if (is_xenos(screen) && (tmpl->bind & PIPE_BIND_RENDER_TARGET) &&
        tmpl->target != PIPE_BUFFER)
