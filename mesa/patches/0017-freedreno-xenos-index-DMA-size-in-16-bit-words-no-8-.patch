 5 files changed, 40 insertions(+), 7 deletions(-)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_screen.c b/src/gallium/drivers/freedreno/a2xx/fd2_screen.c
index 1f94153..a2aaec9 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_screen.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_screen.c
@@ -65,8 +65,11 @@ fd2_screen_is_format_supported(struct pipe_screen *pscreen,
       retval |= PIPE_BIND_DEPTH_STENCIL;
    }
 
+   /* Xenos fetches 16- and 32-bit indices only (VGT_DRAW_INITIATOR has a
+    * one-bit index size); 8-bit index buffers are rewritten by u_vbuf */
    if ((usage & PIPE_BIND_INDEX_BUFFER) &&
-       (fd_pipe2index(format) != (enum pc_di_index_size) ~0)) {
+       (fd_pipe2index(format) != (enum pc_di_index_size) ~0) &&
+       !(is_xenos(fd_screen(pscreen)) && format == PIPE_FORMAT_R8_UINT)) {
       retval |= PIPE_BIND_INDEX_BUFFER;
    }
 
diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h b/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h
index 038db05..5025850 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h
@@ -62,10 +62,20 @@ xenos_rb_copy_dest_info(enum pipe_format format)
    /* swap per hardware (26 Oct 2026): swap 0 writes R,G,B,A bytes for an RGBA target */
    case PIPE_FORMAT_R8G8B8A8_UNORM: case PIPE_FORMAT_R8G8B8X8_UNORM: break;
    case PIPE_FORMAT_B8G8R8A8_UNORM: case PIPE_FORMAT_B8G8R8X8_UNORM: swap = 1; break;
-   case PIPE_FORMAT_A8B8G8R8_UNORM: case PIPE_FORMAT_X8B8G8R8_UNORM: endian = 2; break;
-   case PIPE_FORMAT_A8R8G8B8_UNORM: case PIPE_FORMAT_X8R8G8B8_UNORM: endian = 2; swap = 1; break;
+   /* Resolve endian 3 reverses the bytes of each dword and 2 swaps its halves (measured on
+    * hardware 26 Oct 2026 with dEQP color_clear on an A8R8G8B8 pbuffer, all 8 combinations;
+    * Xenia's Endian128 names 2 "8in32"). */
+   case PIPE_FORMAT_A8B8G8R8_UNORM: case PIPE_FORMAT_X8B8G8R8_UNORM: endian = 3; break;
+   case PIPE_FORMAT_A8R8G8B8_UNORM: case PIPE_FORMAT_X8R8G8B8_UNORM: endian = 3; swap = 1; break;
    default: break;
    }
+   /* experiment hook: XENOS_RESOLVE_<FMT>=<endian><swap>, e.g. XENOS_RESOLVE_A8R8G8B8_UNORM=21 */
+   {
+      char name[64];
+      snprintf(name, sizeof(name), "XENOS_RESOLVE_%s", util_format_name(format) + 12);
+      const char *e = getenv(name);
+      if (e && e[0] && e[1]) { endian = e[0] - '0'; swap = e[1] - '0'; }
+   }
    return endian | (6u << 7) | (swap << 24);
 }
 
diff --git a/src/gallium/drivers/freedreno/freedreno_draw.h b/src/gallium/drivers/freedreno/freedreno_draw.h
index d566a9a..22d7538 100644
--- a/src/gallium/drivers/freedreno/freedreno_draw.h
+++ b/src/gallium/drivers/freedreno/freedreno_draw.h
@@ -112,6 +112,10 @@ fd_draw(struct fd_batch *batch, struct fd_ringbuffer *ring,
       else if (idx_type == INDEX_SIZE_32_BIT)
          idx_swap = 2u << 30;   /* 8in32 */
 #endif
+      /* Xenos VGT_DMA_SIZE counts 16-bit words, not bytes (libxenon writes
+       * count << indextype; Xenia's VGT_DMA_SIZE.num_words) */
+      if (is_xenos(batch->ctx->screen))
+         idx_size /= 2;
       OUT_RELOC(ring, fd_resource(idx_buffer)->bo, idx_offset, 0, 0);
       OUT_RING(ring, idx_size | idx_swap);
    }
