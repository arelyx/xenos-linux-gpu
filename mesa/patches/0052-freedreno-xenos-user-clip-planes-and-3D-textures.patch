diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_resource.c b/src/gallium/drivers/freedreno/a2xx/fd2_resource.c
index 600c793..56d5607 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_resource.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_resource.c
@@ -25,6 +25,23 @@ fd2_layout_resource(struct fd_resource *rsc, enum fd_layout_type type)
    /* 32 pixel alignment */
    fdl_set_pitchalign(&rsc->layout, fdl_cpp_shift(&rsc->layout) + 5);
 
+   /* Xenos 3D textures are linear (fd2_tile_mode): rows 256-byte aligned,
+    * slices of 32-row-aligned height, each level's depth padded to 4 slices
+    * and the level to 4K; mips are sized from the next power of two (Xenia
+    * texture_util GetGuestTextureLayout). */
+   if (is_xenos(fd_screen(prsc->screen)) && prsc->target == PIPE_TEXTURE_3D) {
+      fdl_set_pitchalign(&rsc->layout, MAX2(fdl_cpp_shift(&rsc->layout) + 5, 8));
+      for (level = 0; level <= prsc->last_level; level++) {
+         struct fdl_slice *slice = fd_resource_slice(rsc, level);
+         uint32_t rows = level ? MAX2(util_next_power_of_two(height0) >> level, 1) : height0;
+         uint32_t depth = level ? MAX2(util_next_power_of_two(prsc->depth0) >> level, 1) : prsc->depth0;
+         slice->offset = size;
+         slice->size0 = fdl2_pitch(&rsc->layout, level) * align(rows, 32);
+         size += align(slice->size0 * align(depth, 4), 4096);
+      }
+      return size;
+   }
+
    for (level = 0; level <= prsc->last_level; level++) {
       struct fdl_slice *slice = fd_resource_slice(rsc, level);
       uint32_t pitch = fdl2_pitch(&rsc->layout, level);
@@ -51,6 +68,9 @@ fd2_tile_mode(const struct pipe_resource *tmpl)
     */
    if (tmpl->target == PIPE_TEXTURE_CUBE && !fd2_xenos)
       return 0;
+   /* Xenos: 3D textures are linear (their tiled layout isn't implemented) */
+   if (tmpl->target == PIPE_TEXTURE_3D && fd2_xenos)
+      return 0;
    /* Xenos: cube faces are (de)tiled on the CPU like 2D textures, and the
     * linear layout's mip pitches didn't match what the sampler reads (POT
     * cubes with mipmaps failed in dEQP) */
