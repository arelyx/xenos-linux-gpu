    if (cso->min_mip_filter != PIPE_TEX_MIPFILTER_NONE)
       so->tex4 = A2XX_SQ_TEX_4_LOD_BIAS(cso->lod_bias);
+   /* Xenos: filtering between 3D slices (dword 4 bits 0/1, Xenia
+    * vol_mag_filter/vol_min_filter: 0 point, 1 linear) */
+   if (fd2_xenos)
+      so->tex4 |= (cso->mag_img_filter == PIPE_TEX_FILTER_LINEAR ? 1 : 0) |
+                  (cso->min_img_filter == PIPE_TEX_FILTER_LINEAR ? 2 : 0);
 
    return so;
 }
@@ -146,7 +151,7 @@ tex_dimension(unsigned target)
    case PIPE_TEXTURE_2D:
       return SQ_TEX_DIMENSION_2D;
    case PIPE_TEXTURE_3D:
-      assert(0); /* TODO */
+      assert(fd2_xenos); /* TODO on Adreno */
       return SQ_TEX_DIMENSION_3D;
    case PIPE_TEXTURE_CUBE:
       return SQ_TEX_DIMENSION_CUBE;
@@ -196,6 +201,9 @@ fd2_sampler_view_create(struct pipe_context *pctx, struct pipe_resource *prsc,
    so->tex2 = A2XX_SQ_TEX_2_HEIGHT(prsc->height0 - 1) |
               A2XX_SQ_TEX_2_WIDTH(prsc->width0 - 1) |
               COND(prsc->target == PIPE_TEXTURE_CUBE, A2XX_SQ_TEX_2_DEPTH(6));
+   /* 3D sizes are 11/11/10 bits (Xenia xe_gpu_texture_fetch_t size_3d) */
+   if (prsc->target == PIPE_TEXTURE_3D)
+      so->tex2 = (prsc->width0 - 1) | (prsc->height0 - 1) << 11 | (prsc->depth0 - 1) << 22;
    so->tex3 = A2XX_SQ_TEX_3_NUM_FORMAT(fmt.num_format) |
               fd2_tex_swiz(cso->format, cso->swizzle_r, cso->swizzle_g,
                            cso->swizzle_b, cso->swizzle_a) |
