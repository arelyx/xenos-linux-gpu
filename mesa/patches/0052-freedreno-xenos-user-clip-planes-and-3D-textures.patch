index 37f6d64..0f79180 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
@@ -167,6 +167,10 @@ emit_texture(struct fd_ringbuffer *ring, struct fd_context *ctx,
       tex2 = (tex2 & ~(A2XX_SQ_TEX_2_WIDTH__MASK | A2XX_SQ_TEX_2_HEIGHT__MASK)) |
              A2XX_SQ_TEX_2_WIDTH(u_minify(prsc->width0, base_level) - 1) |
              A2XX_SQ_TEX_2_HEIGHT(u_minify(prsc->height0, base_level) - 1);
+      if (prsc->target == PIPE_TEXTURE_3D)   /* 11/11/10-bit sizes */
+         tex2 = (u_minify(prsc->width0, base_level) - 1) |
+                (u_minify(prsc->height0, base_level) - 1) << 11 |
+                (u_minify(prsc->depth0, base_level) - 1) << 22;
    }
    OUT_RING(ring, sampler->tex0 | tex0);
    if (rsc)
@@ -334,6 +338,15 @@ fd2_emit_state(struct fd_context *ctx, const enum fd_dirty_3d_state dirty)
       OUT_RING(ring, zsa->rb_alpha_ref);
    }
 
+   /* user clip planes: PA_CL_UCP_0_X.. (0x2388, 4 floats each) */
+   if (fd2_xenos && (dirty & FD_DIRTY_UCP)) {
+      OUT_PKT3(ring, CP_SET_CONSTANT, 1 + 6 * 4);
+      OUT_RING(ring, CP_REG(0x2388));
+      for (unsigned i = 0; i < 6; i++)
+         for (unsigned j = 0; j < 4; j++)
+            OUT_RING(ring, fui(ctx->ucp.ucp[i][j]));
+   }
+
