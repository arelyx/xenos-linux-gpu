diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
index a8dfba7..919e937 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
@@ -82,8 +82,11 @@ draw_impl(struct fd_context *ctx, const struct pipe_draw_info *info,
    OUT_RING(ring, info->index_size ? 0 : draw->start);
 
    if (is_xenos(ctx->screen)) {
-      fd2_xenos_invalidate_caches(ring);
-      /* and each vertex buffer exactly, as libxenon does on unlock */
+      /* Invalidate exact ranges, as libxenon does on unlock. The all-of-DRAM
+       * form doesn't reliably reach the texture cache either: a recycled cube
+       * texture BO sampled stale texels after other dEQP cases (26 Oct 2026). */
+      if (fd2_xenos_full_inval())
+         fd2_xenos_invalidate_caches(ring);
       struct fd_vertex_stateobj *vtx = ctx->vtx.vtx;
       for (unsigned i = 0; vtx && i < vtx->num_elements; i++) {
          struct pipe_vertex_buffer *vb = &ctx->vtx.vertexbuf.vb[vtx->pipe[i].vertex_buffer_index];
@@ -92,6 +95,23 @@ draw_impl(struct fd_context *ctx, const struct pipe_draw_info *info,
             fd2_xenos_invalidate_bo(ring, bo, fd_bo_size(bo));
          }
       }
+      if (info->index_size && !info->has_user_indices && info->index.resource) {
+         struct fd_bo *bo = fd_resource(info->index.resource)->bo;
+         fd2_xenos_invalidate_bo(ring, bo, fd_bo_size(bo));
+      }
+      /* textures only after the CPU wrote them or they got a new BO; resolves
+       * flush and invalidate their own destination */
+      for (unsigned s = 0; s < 2; s++) {
+         struct fd_texture_stateobj *tex = &ctx->tex[s ? MESA_SHADER_FRAGMENT : MESA_SHADER_VERTEX];
+         for (unsigned i = 0; i < tex->num_textures; i++) {
+            struct fd_resource *rsc = tex->textures[i] && tex->textures[i]->texture ?
+               fd_resource(tex->textures[i]->texture) : NULL;
+            if (rsc && rsc->xenos_tc_stale) {
+               fd2_xenos_invalidate_bo(ring, rsc->bo, fd_bo_size(rsc->bo));
+               rsc->xenos_tc_stale = false;
+            }
+         }
+      }
    } else {
       OUT_PKT0(ring, REG_A2XX_TC_CNTL_STATUS, 1);
       OUT_RING(ring, A2XX_TC_CNTL_STATUS_L2_INVALIDATE);
