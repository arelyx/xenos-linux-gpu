@@ -427,6 +427,17 @@ fd2_emit_tile_mem2gmem(struct fd_batch *batch,
 
    if (is_xenos(ctx->screen)) {
       fd2_xenos_invalidate_caches(ring);
+      /* the restore samples the framebuffer: as for textures, invalidate it
+       * exactly if the CPU wrote it (the all-of-DRAM form above doesn't
+       * reliably reach the texture cache) */
+      struct pipe_resource *restored[2] = { pfb->zsbuf.texture, pfb->nr_cbufs ? pfb->cbufs[0].texture : NULL };
+      for (unsigned i = 0; i < 2; i++) {
+         struct fd_resource *rsc = restored[i] ? fd_resource(restored[i]) : NULL;
+         if (rsc && rsc->xenos_tc_stale) {
+            fd2_xenos_invalidate_bo(ring, rsc->bo, fd_bo_size(rsc->bo));
+            rsc->xenos_tc_stale = false;
+         }
+      }
       fd2_xenos_invalidate_bo(ring, fd_resource(fd2_ctx->solid_vertexbuf)->bo,
                               fd_bo_size(fd_resource(fd2_ctx->solid_vertexbuf)->bo));
    } else {
diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h b/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h
index de55885..13b3578 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_xenos.h
@@ -134,6 +134,17 @@ fd2_xenos_skip_full_inval(void)
    return v;
 }
 
+/* experiment hook: the all-of-DRAM invalidate before every draw, as before
+ * draws invalidated exact ranges */
+static inline bool
+fd2_xenos_full_inval(void)
+{
+   static int v = -1;
+   if (v < 0)
+      v = getenv("XENOS_FULL_INVAL") != NULL;
+   return v;
+}
+
 #define fd2_xenos_invalidate_caches(ring)                                      \
    do {                                                                        \
       if (fd2_xenos_skip_full_inval()) break;                                  \
