---
 src/gallium/drivers/freedreno/a2xx/fd2_draw.c |  3 ++-
 src/gallium/drivers/freedreno/a2xx/fd2_emit.c | 15 +++++++++++++
 src/gallium/drivers/freedreno/a2xx/ir2.h      |  4 ++++
 src/gallium/drivers/freedreno/a2xx/ir2_nir.c  | 22 +++++++++++++++++++
 4 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
index 0ba81b8..5a2d3ea 100644
