 src/gallium/drivers/freedreno/freedreno_blitter.c  |  9 ++++++++-
 src/gallium/drivers/freedreno/freedreno_resource.c | 13 +++----------
 src/gallium/drivers/freedreno/freedreno_screen.c   |  6 ++++++
 src/gallium/include/pipe/p_defines.h               |  1 +
 src/mesa/state_tracker/st_cb_readpixels.c          |  6 ++++--
 5 files changed, 22 insertions(+), 13 deletions(-)

diff --git a/src/gallium/drivers/freedreno/freedreno_blitter.c b/src/gallium/drivers/freedreno/freedreno_blitter.c
index b0c1827..89432c3 100644
--- a/src/gallium/drivers/freedreno/freedreno_blitter.c
+++ b/src/gallium/drivers/freedreno/freedreno_blitter.c
@@ -80,7 +80,14 @@ fd_blitter_pipe_begin(struct fd_context *ctx, bool render_cond) assert_dt
                                 ctx->streamout.targets, MESA_PRIM_UNKNOWN);
    util_blitter_save_rasterizer(ctx->blitter, ctx->rasterizer);
    util_blitter_save_viewport(ctx->blitter, &ctx->viewport[0]);
-   util_blitter_save_scissor(ctx->blitter, &ctx->scissor[0]);
+   /* ctx->scissor keeps inclusive max bounds; the blitter restores what it
+    * saved through set_scissor_states(), which takes exclusive ones. Saved
+    * as is, every scissored blit shrank the application's scissor by a pixel
+    * (an empty scissor, min 1 max 0, stays empty: min == max). */
+   struct pipe_scissor_state saved_scissor = ctx->scissor[0];
+   saved_scissor.maxx += 1;
+   saved_scissor.maxy += 1;
+   util_blitter_save_scissor(ctx->blitter, &saved_scissor);
    util_blitter_save_fragment_shader(ctx->blitter, ctx->prog.fs);
    util_blitter_save_blend(ctx->blitter, ctx->blend);
    util_blitter_save_depth_stencil_alpha(ctx->blitter, ctx->zsa);
diff --git a/src/gallium/drivers/freedreno/freedreno_resource.c b/src/gallium/drivers/freedreno/freedreno_resource.c
index 97edfab..64b5af3 100644
--- a/src/gallium/drivers/freedreno/freedreno_resource.c
+++ b/src/gallium/drivers/freedreno/freedreno_resource.c
@@ -780,16 +780,9 @@ xenos_inval_cached(struct fd_resource *rsc, unsigned level)
 #if defined(__powerpc__)
    if (!fd_bo_is_cached(rsc->bo))
       return;
-   /* just the level: dcbf costs a bus transaction per line, and a staging
-    * buffer's BO is at least a 64K page */
-   uintptr_t p = (uintptr_t)fd_bo_map(rsc->bo) + fd_resource_offset(rsc, level, 0);
-   uintptr_t end = MIN2(p + (uintptr_t)fd_resource_layer_stride(rsc, level) *
-                               MAX2(rsc->b.b.array_size, u_minify(rsc->b.b.depth0, level)),
-                        (uintptr_t)fd_bo_map(rsc->bo) + fd_bo_size(rsc->bo));
-   if (rsc->b.b.target == PIPE_BUFFER || end <= p) {
-      p = (uintptr_t)fd_bo_map(rsc->bo);
-      end = p + fd_bo_size(rsc->bo);
-   }
+   /* the whole BO, to be safe about tiled padding (only readback staging of
+    * 64K or more is cached, and dcbf on 64K takes microseconds) */
+   uintptr_t p = (uintptr_t)fd_bo_map(rsc->bo), end = p + fd_bo_size(rsc->bo);
    for (p &= ~(uintptr_t)127; p < end; p += 128)
       __asm__ volatile("dcbf 0,%0" : : "r"(p) : "memory");
    __asm__ volatile("sync" : : : "memory");
