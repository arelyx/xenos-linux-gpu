@@ -448,6 +448,12 @@ fd_init_screen_caps(struct fd_screen *screen)
     * XENOS_BLIT_MIN_PIXELS sends smaller transfers to the CPU path. */
    caps->texture_transfer_blit_min_pixels =
       is_xenos(screen) ? debug_get_num_option("XENOS_BLIT_MIN_PIXELS", 1) : 0;
+   /* Readback by blit for 128x128 and up only: below that, one dEQP case
+    * (fbo.render.color.blend_npot_rbo_bgra_depth_component16, 111x122) reads
+    * 16 wrong rows when it runs after the other fbo.render.color cases, and
+    * passes alone. Not understood yet. */
+   caps->readpixels_blit_min_pixels =
+      is_xenos(screen) ? debug_get_num_option("XENOS_READ_BLIT_MIN_PIXELS", 128 * 128) : 0;
 
    caps->pci_group =
    caps->pci_bus =
