+++ b/src/gallium/drivers/freedreno/a2xx/ir2.c
@@ -8,6 +8,12 @@
 
 #include "ir2_private.h"
 
+/* Keep ir2's asserts in release builds: a shader it can't compile then aborts
+ * the process instead of reaching the GPU half-built and wedging it (no reset
+ * on Xenos). compile_error() is an assert too. */
+#undef NDEBUG
+#include <assert.h>   /* after the other headers, which key off NDEBUG */
+
