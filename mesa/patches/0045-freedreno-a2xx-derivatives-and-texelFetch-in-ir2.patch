+/* getGradients works on one value at a time: split vector derivatives */
+static bool
+ir2_scalarize_derivatives(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   switch (intr->intrinsic) {
+   case nir_intrinsic_ddx: case nir_intrinsic_ddx_fine: case nir_intrinsic_ddx_coarse:
+   case nir_intrinsic_ddy: case nir_intrinsic_ddy_fine: case nir_intrinsic_ddy_coarse:
+      break;
+   default:
+      return false;
+   }
+   if (intr->def.num_components == 1)
+      return false;
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *comps[4];
+   for (unsigned i = 0; i < intr->def.num_components; i++) {
+      nir_intrinsic_instr *c = nir_intrinsic_instr_create(b->shader, intr->intrinsic);
+      c->src[0] = nir_src_for_ssa(nir_channel(b, intr->src[0].ssa, i));
+      c->num_components = 1;
+      nir_def_init(&c->instr, &c->def, 1, intr->def.bit_size);
+      nir_builder_instr_insert(b, &c->instr);
+      comps[i] = &c->def;
+   }
+   nir_def_replace(&intr->def, nir_vec(b, comps, intr->def.num_components));
+   return true;
+}
+
+/* texelFetch (txf, used by Mesa's blits and copies): sample at the texel
+ * center with unnormalized coordinates, as for rectangle textures, at the
+ * given level. 2D only. */
+static bool
+ir2_lower_txf(nir_builder *b, nir_tex_instr *tex, void *data)
+{
+   if (tex->op != nir_texop_txf ||
+       (tex->sampler_dim != GLSL_SAMPLER_DIM_2D && tex->sampler_dim != GLSL_SAMPLER_DIM_RECT))
+      return false;
+
+   b->cursor = nir_before_instr(&tex->instr);
+   int c = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+   if (c >= 0) {
+      nir_def *coord = nir_fadd_imm(b, nir_i2f32(b, tex->src[c].src.ssa), 0.5f);
+      nir_src_rewrite(&tex->src[c].src, coord);
+   }
+   int l = nir_tex_instr_src_index(tex, nir_tex_src_lod);
+   if (l >= 0)
+      nir_src_rewrite(&tex->src[l].src, nir_i2f32(b, tex->src[l].src.ssa));
+   tex->op = nir_texop_txl;
+   tex->sampler_dim = GLSL_SAMPLER_DIM_RECT;
+   return true;
+}
+
 int
 ir2_optimize_nir(nir_shader *s, bool lower)
 {
@@ -149,6 +200,8 @@ ir2_optimize_nir(nir_shader *s, bool lower)
       OPT_V(s, ir3_nir_apply_trig_workarounds);
       OPT_V(s, nir_lower_tex, &tex_options);
       OPT_V(s, nir_shader_tex_pass, ir2_lower_tex_shadow, nir_metadata_control_flow, NULL);
+      OPT_V(s, nir_shader_tex_pass, ir2_lower_txf, nir_metadata_control_flow, NULL);
+      OPT_V(s, nir_shader_intrinsics_pass, ir2_scalarize_derivatives, nir_metadata_control_flow, NULL);
    }
 
    ir2_optimize_loop(s);
@@ -720,6 +773,20 @@ emit_intrinsic(struct ir2_context *ctx, nir_intrinsic_instr *intr)
       instr->src[0] =
          ir2_src(ctx->f->inputs_count, IR2_SWIZZLE_ZW, IR2_SRC_INPUT);
       break;
+   case nir_intrinsic_ddx:
+   case nir_intrinsic_ddx_fine:
+   case nir_intrinsic_ddx_coarse:
+   case nir_intrinsic_ddy:
+   case nir_intrinsic_ddy_fine:
+   case nir_intrinsic_ddy_coarse: {
+      /* getGradients (scalarized by ir2_scalarize_derivatives) */
+      instr = ir2_instr_create_fetch(ctx, &intr->def, TEX_GET_GRADIENTS);
+      instr->src[0] = make_src_noconst(ctx, intr->src[0]);
+      instr->fetch.tex.grad_y = intr->intrinsic == nir_intrinsic_ddy ||
+                                intr->intrinsic == nir_intrinsic_ddy_fine ||
+                                intr->intrinsic == nir_intrinsic_ddy_coarse;
+      break;
+   }
    default:
       compile_error(ctx, "unimplemented intr %s\n", nir_intrinsic_infos[intr->intrinsic].name);
       break;
