---
 src/gallium/drivers/freedreno/freedreno_resource.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/gallium/drivers/freedreno/freedreno_resource.c b/src/gallium/drivers/freedreno/freedreno_resource.c
index f612c9c..74f9ebd 100644
--- a/src/gallium/drivers/freedreno/freedreno_resource.c
+++ b/src/gallium/drivers/freedreno/freedreno_resource.c
@@ -1883,6 +1883,18 @@ fd_layout_resource_for_handle(struct fd_resource *rsc, struct winsys_handle *han
    else
       rsc->layout.pitchalign = MAX2(rsc->layout.pitchalign, 5);
 
+   /* a2xx lays resources out with 32-pixel pitch alignment (fd2_layout_resource),
+    * not gmem_align_w (128): its own exported buffers failed to import, so X's
+    * DRI3 rejected every client back buffer. Xenos renders and resolves only
+    * the tiled layout, so a buffer it shares is tiled. */
+   if (is_a2xx(screen)) {
+      rsc->layout.pitchalign = fdl_cpp_shift(&rsc->layout) + 5;
+      if (is_xenos(screen)) {
+         rsc->layout.tile_mode = 1;
+         slice->size0 = align(handle->stride * align(prsc->height0, 32), 4096);
+      }
+   }
+
    if (rsc->layout.pitch0 < (prsc->width0 * rsc->layout.cpp) ||
        fd_resource_pitch(rsc, 0) != rsc->layout.pitch0)
       return false;
