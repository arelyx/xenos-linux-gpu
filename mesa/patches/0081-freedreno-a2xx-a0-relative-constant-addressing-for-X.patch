--- a/src/freedreno/ir2/disasm-a2xx.c
+++ b/src/freedreno/ir2/disasm-a2xx.c
@@ -251,12 +251,19 @@ disasm_alu(const uint32_t *dwords, uint32_t alu_off, int level, int sync,
    if (alu->vector_clamp)
       printf(" CLAMP");
 
+   /* a0/aL-relative constant operands */
+   if (alu->const_0_rel_abs || alu->const_1_rel_abs)
+      printf(" REL(%s%s%s)", alu->const_0_rel_abs ? "c0" : "",
+             alu->const_1_rel_abs ? "c1" : "",
+             alu->relative_addr ? ",a0" : ",aL");
+
    if (alu->export_data)
       print_export_comment(alu->vector_dest, type);
 
    printf("\n");
 
-   if (alu->scalar_write_mask || !alu->vector_write_mask) {
+   if (alu->scalar_write_mask || !alu->vector_write_mask ||
+       alu->scalar_opc == MOVAs || alu->scalar_opc == MOVA_FLOORs) {
       /* 2nd optional scalar op: */
 
       printf("%s", levels[level]);
diff --git a/src/gallium/drivers/freedreno/a2xx/ir2.c b/src/gallium/drivers/freedreno/a2xx/ir2.c
index 85c8e3f..98f1ca6 100644
--- a/src/gallium/drivers/freedreno/a2xx/ir2.c
+++ b/src/gallium/drivers/freedreno/a2xx/ir2.c
@@ -23,12 +23,26 @@ scalar_possible(struct ir2_instr *instr)
    return src_ncomp(instr) == 1;
 }
 
+static bool
+has_rel_src(struct ir2_instr *instr)
+{
+   for (unsigned i = 0; i < instr->src_count; i++)
+      if (instr->src[i].type == IR2_SRC_CONST && instr->src[i].rel)
+         return true;
+   return false;
+}
+
 static bool
 is_alu_compatible(struct ir2_instr *a, struct ir2_instr *b)
 {
    if (!a)
       return true;
 
+   /* an a0-relative constant read is issued alone: the relative bits are
+    * shared by all constant operands of the ALU instruction */
+   if (has_rel_src(a) || has_rel_src(b))
+      return false;
+
    /* dont use same instruction twice */
    if (a == b)
       return false;
@@ -122,6 +136,10 @@ insert(struct ir2_context *ctx, unsigned block_idx, unsigned reg_idx,
       if (s->instr->type != IR2_ALU || s->instr->alu.export >= 0)
          continue;
 
+      /* a constant scalar operand would take the a0 offset too */
+      if (has_rel_src(s->instr))
+         continue;
+
       sched = s;
    }
    *comp = ffs(mask) - 1;
@@ -181,6 +199,7 @@ scalarize_case1(struct ir2_context *ctx, struct ir2_instr *instr, bool order)
 
    assert(ctx->instr_count < IR2_MAX_INSTR);
    ins = &ctx->instr[idx = ctx->instr_count++];
+   ins->dep = ins->after = -1;
    ins->idx = idx;
    ins->type = IR2_ALU;
    ins->src[0] = src1;
@@ -275,6 +294,12 @@ sched_next(struct ir2_context *ctx, struct ir2_sched_instr *sched)
       /* don't reorder across predicates */
       if (avail_count && instr->pred != avail[0]->pred)
          is_ok = false;
+      /* a0: a relative read after its MOVA, a MOVA after the previous
+       * relative read */
+      if (instr->dep >= 0 && ctx->instr[instr->dep].need_emit)
+         is_ok = false;
+      if (instr->after >= 0 && ctx->instr[instr->after].need_emit)
+         is_ok = false;
 
       if (!is_ok)
          continue;
@@ -417,6 +442,7 @@ schedule_instrs(struct ir2_context *ctx)
          /* generate the SET_LOD instruction */
          assert(ctx->instr_count < IR2_MAX_INSTR);
          tex_lod = &ctx->instr[ctx->instr_count++];
+         tex_lod->dep = tex_lod->after = -1;
          tex_lod->type = IR2_FETCH;
          tex_lod->block_idx = instr->block_idx;
          tex_lod->pred = instr->pred;
diff --git a/src/gallium/drivers/freedreno/a2xx/ir2_assemble.c b/src/gallium/drivers/freedreno/a2xx/ir2_assemble.c
index 7595262..1511d92 100644
--- a/src/gallium/drivers/freedreno/a2xx/ir2_assemble.c
+++ b/src/gallium/drivers/freedreno/a2xx/ir2_assemble.c
@@ -306,6 +306,24 @@ fill_instr(struct ir2_context *ctx, struct ir2_sched_instr *sched, instr_t *bc,
       }
 
       bc->alu.pred_select = instr_v->pred;
+
+      /* a0-relative constants: the first constant operand takes its mode
+       * from const_0_rel_abs, later ones from const_1_rel_abs (Xenia
+       * ucode.h src_const_is_addressed) */
+      struct ir2_src *vsrc[3] = {&src1, &src2, src3};
+      unsigned nconst = 0;
+      for (unsigned i = 0; i < 3 && vsrc[i]; i++) {
+         if (vsrc[i]->type != IR2_SRC_CONST)
+            continue;
+         if (vsrc[i]->rel) {
+            if (nconst)
+               bc->alu.const_1_rel_abs = 1;
+            else
+               bc->alu.const_0_rel_abs = 1;
+            bc->alu.relative_addr = 1;
+         }
+         nconst++;
+      }
    }
 
    if (instr_s) {
@@ -336,6 +354,12 @@ fill_instr(struct ir2_context *ctx, struct ir2_sched_instr *sched, instr_t *bc,
       if (instr_v)
          assert(instr_s->pred == instr_v->pred);
       bc->alu.pred_select = instr_s->pred;
+
+      if (src->type == IR2_SRC_CONST && src->rel) {
+         assert(!instr_v); /* issued alone, see is_alu_compatible */
+         bc->alu.const_0_rel_abs = 1;
+         bc->alu.relative_addr = 1;
+      }
    }
 
    *is_fetch = false;
