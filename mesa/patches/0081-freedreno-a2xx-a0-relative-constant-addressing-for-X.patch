             /* cant apply abs to const src, const src only for alu */
             if (p->src[0].type == IR2_SRC_CONST &&
                 (src->abs || instr->type != IR2_ALU))
diff --git a/src/gallium/drivers/freedreno/a2xx/ir2_nir.c b/src/gallium/drivers/freedreno/a2xx/ir2_nir.c
index b367085..f5994dc 100644
--- a/src/gallium/drivers/freedreno/a2xx/ir2_nir.c
+++ b/src/gallium/drivers/freedreno/a2xx/ir2_nir.c
@@ -439,6 +439,7 @@ ir2_instr_create(struct ir2_context *ctx, int type)
    instr->block_idx = ctx->block_idx;
    instr->pred = ctx->pred;
    instr->is_ssa = true;
+   instr->dep = instr->after = -1;
    /* give every result a live range (internal instructions - predicates,
     * kills - left block_idx_free at 0 and held their register to the end of
     * the shader: 30 of the 64 in dEQP uniform_api.random.3) */
@@ -813,11 +814,30 @@ emit_intrinsic(struct ir2_context *ctx, nir_intrinsic_instr *intr)
       break;
    case nir_intrinsic_load_uniform:
       const_offset = nir_src_as_const_value(intr->src[0]);
-      assert(const_offset); /* TODO can be false in ES2? */
       idx = nir_intrinsic_base(intr);
-      idx += (uint32_t)const_offset[0].f32;
+      if (const_offset) {
+         idx += (uint32_t)const_offset[0].f32;
+         instr = instr_create_alu_dest(ctx, nir_op_mov, &intr->def);
+         instr->src[0] = ir2_src(idx, 0, IR2_SRC_CONST);
+         break;
+      }
+      /* Xenos vertex shaders (indirect_const_addr): MOVAs sets
+       * a0 = floor(offset + 0.5), then the constant operand reads
+       * c[base + a0]. The scheduler keeps each MOVA between the previous
+       * relative read and its own. */
+      assert(ctx->so->is_xenos && ctx->so->type == MESA_SHADER_VERTEX);
+      struct ir2_instr *mova = ir2_instr_create(ctx, IR2_ALU);
+      mova->alu.vector_opc = VECTOR_NONE;
+      mova->alu.scalar_opc = MOVAs;
+      mova->alu.export = -1;
+      mova->src_count = 1;
+      mova->src[0] = make_src(ctx, intr->src[0]);
+      mova->after = ctx->last_rel;
       instr = instr_create_alu_dest(ctx, nir_op_mov, &intr->def);
       instr->src[0] = ir2_src(idx, 0, IR2_SRC_CONST);
+      instr->src[0].rel = 1;
+      instr->dep = mova->idx;
+      ctx->last_rel = instr->idx;
       break;
    case nir_intrinsic_terminate:
    case nir_intrinsic_terminate_if:
@@ -1641,6 +1661,7 @@ ir2_nir_compile(struct ir2_context *ctx, bool binning)
    struct fd2_shader_stateobj *so = ctx->so;
 
    memset(ctx->ssa_map, 0xff, sizeof(ctx->ssa_map));
+   ctx->last_rel = -1;
 
    ctx->nir = nir_shader_clone(NULL, so->nir);
 
