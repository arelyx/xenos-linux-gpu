+#define IR2_BORDER_AXES    0x07 /* s, t, r wrap to the border */
+#define IR2_BORDER_MIRROR  0x08 /* ... mirrored once (|coord| > 1 is outside) */
+#define IR2_BORDER_NEAREST 0x10 /* select the color outside [0, 1] */
+#define IR2_BORDER_LINEAR  0x20 /* fetch again with the white border from
