+      /* linear: the hardware's own border when it is (0, 0, 0, 0) or
+       * (1, 1, 1, 1); otherwise a second fetch constant with the white
+       * border, in a vertex texture slot left free (26-31 with no more than
+       * 8 vertex samplers) */
+      bool half = false;
+      for (unsigned a = 0; a < dims; a++)
+         half |= wrap[a] == PIPE_TEX_WRAP_CLAMP || wrap[a] == PIPE_TEX_WRAP_MIRROR_CLAMP;
+      if (!(k & IR2_BORDER_AXES) && !half)
+         continue;
+      const float *c = ss->border_color.f;
+      if ((c[0] == 0.0f && c[1] == 0.0f && c[2] == 0.0f && c[3] == 0.0f) ||
+          (c[0] == 1.0f && c[1] == 1.0f && c[2] == 1.0f && c[3] == 1.0f))
+         continue;
+      if (ndup < 6 && ctx->tex[MESA_SHADER_VERTEX].num_samplers <= 8)
+         key[i] = IR2_BORDER_LINEAR | ndup++;
+   }
+}
