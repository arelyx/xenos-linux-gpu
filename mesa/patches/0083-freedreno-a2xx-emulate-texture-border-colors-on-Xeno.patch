+/* border colors the hardware can't give (see IR2_BORDER_CONST): with point
+ * sampling, the color wherever a coordinate on a border axis is outside
+ * [0, 1] (mirrored once: |coord| > 1) */
+static bool
+ir2_lower_border(nir_builder *b, nir_tex_instr *tex, void *data)
+{
+   const uint8_t *border = data;
+
+   if ((tex->op != nir_texop_tex && tex->op != nir_texop_txb &&
+        tex->op != nir_texop_txl && tex->op != nir_texop_txd) ||
+       tex->sampler_index >= 12 ||
+       !(border[tex->sampler_index] & (IR2_BORDER_NEAREST | IR2_BORDER_LINEAR)) ||
+       nir_tex_instr_src_index(tex, nir_tex_src_comparator) >= 0 ||
+       tex->is_array || tex->sampler_dim == GLSL_SAMPLER_DIM_RECT ||
+       tex->sampler_dim == GLSL_SAMPLER_DIM_CUBE)
+      return false;
+
+   int c = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+   if (c < 0)
+      return false;
+
+   uint8_t key = border[tex->sampler_index];
+   nir_def *coord = tex->src[c].src.ssa;
+   b->cursor = nir_after_instr(&tex->instr);
+
+   if (key & IR2_BORDER_LINEAR) {
+      /* this fetch has the black border, (0, 0, 0, 0), and a copy with the
+       * white one: per channel their difference is the border's filter
+       * weight (0 for a channel the format fixes), so
+       * black + (white - black) * color is the color's blend, exact for any
+       * filter and level */
+      unsigned sampler = tex->sampler_index;
+      nir_tex_instr *white = nir_instr_as_tex(nir_instr_clone(b->shader, &tex->instr));
+      white->sampler_index = white->texture_index = IR2_BORDER_DUP_SLOT(key & 0x7);
+      nir_builder_instr_insert(b, &white->instr);
+      nir_def *color = nir_load_uniform(b, 4, 32, nir_imm_int(b, 0),
+                                        .base = IR2_BORDER_CONST + sampler);
+      color = nir_trim_vector(b, color, tex->def.num_components);
+      nir_def *w = nir_fsub(b, &white->def, &tex->def);
+      nir_def *res = nir_fadd(b, nir_fmul(b, w, color), &tex->def);
+      nir_def_rewrite_uses_after(&tex->def, res);
+      return true;
+   }
+
+   nir_def *outside = nir_imm_false(b);
+   for (unsigned i = 0; i < coord->num_components && i < 3; i++) {
+      if (!(key & (1 << i)))
+         continue;
+      nir_def *x = nir_channel(b, coord, i);
+      if (key & IR2_BORDER_MIRROR)
+         x = nir_fabs(b, x);
+      outside = nir_ior(b, outside, nir_fgt_imm(b, x, 1.0f));
+      if (!(key & IR2_BORDER_MIRROR))
+         outside = nir_ior(b, outside, nir_flt_imm(b, x, 0.0f));
+   }
+
+   nir_def *color = nir_load_uniform(b, 4, 32, nir_imm_int(b, 0),
+                                     .base = IR2_BORDER_CONST + tex->sampler_index);
+   color = nir_trim_vector(b, color, tex->def.num_components);
+   nir_def *res = nir_bcsel(b, outside, color, &tex->def);
+   nir_def_rewrite_uses_after(&tex->def, res);
+   return true;
+}
