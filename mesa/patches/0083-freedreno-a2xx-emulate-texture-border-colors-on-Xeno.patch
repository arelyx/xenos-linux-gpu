+static bool
+wrap_is_border(unsigned wrap)
+{
+   return wrap == PIPE_TEX_WRAP_CLAMP_TO_BORDER || wrap == PIPE_TEX_WRAP_MIRROR_CLAMP_TO_BORDER;
+}
+
+/* which samplers the fragment shader must give their border color itself
+ * (IR2_BORDER_CONST): point sampling never reads the hardware border */
+void
+fd2_border_key(struct fd_context *ctx, struct fd2_shader_stateobj *fp, uint8_t key[12])
+   assert_dt
+{
+   struct fd_texture_stateobj *tex = &ctx->tex[MESA_SHADER_FRAGMENT];
+
+   unsigned ndup = 0;
+
+   memset(key, 0, 12);
+   u_foreach_bit (i, fp->tex_samplers & tex->valid_samplers & 0xfff) {
+      const struct pipe_sampler_state *ss = tex->samplers[i];
+      const struct pipe_sampler_view *view = i < tex->num_textures ? tex->textures[i] : NULL;
+
+      if (!ss || !view || ss->compare_mode != PIPE_TEX_COMPARE_NONE)
+         continue;
+      if (view->target != PIPE_TEXTURE_1D && view->target != PIPE_TEXTURE_2D &&
+          view->target != PIPE_TEXTURE_3D)
+         continue;
+
+      unsigned dims = view->target == PIPE_TEXTURE_1D ? 1 : view->target == PIPE_TEXTURE_2D ? 2 : 3;
+      const unsigned wrap[3] = {ss->wrap_s, ss->wrap_t, ss->wrap_r};
+      uint8_t k = 0;
+      for (unsigned a = 0; a < dims; a++) {
+         if (wrap_is_border(wrap[a]))
+            k |= 1 << a;
+         if (wrap[a] == PIPE_TEX_WRAP_MIRROR_CLAMP_TO_BORDER)
+            k |= IR2_BORDER_MIRROR;
+      }
+      if (ss->mag_img_filter == PIPE_TEX_FILTER_NEAREST) {
+         if (k & IR2_BORDER_AXES)
+            key[i] = k | IR2_BORDER_NEAREST;
+         continue;
+      }
