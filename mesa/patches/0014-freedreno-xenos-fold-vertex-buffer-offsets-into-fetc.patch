diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
index 126452a..a5ae181 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
@@ -55,7 +55,9 @@ emit_vertexbufs(struct fd_context *ctx) assert_dt
    for (i = 0; i < vtx->num_elements; i++) {
       struct pipe_vertex_element *elem = &vtx->pipe[i];
       struct pipe_vertex_buffer *vb = &vertexbuf->vb[elem->vertex_buffer_index];
-      bufs[i].offset = vb->buffer_offset;
+      /* Xenos: fetch from the start of the BO; the buffer offset goes into the
+       * fetch instruction's offset (fd2_program.c patch_vtx_fetch) */
+      bufs[i].offset = is_xenos(ctx->screen) ? 0 : vb->buffer_offset;
       bufs[i].size = fd_bo_size(fd_resource(vb->buffer.resource)->bo);
       bufs[i].prsc = vb->buffer.resource;
    }
@@ -78,6 +80,15 @@ draw_impl(struct fd_context *ctx, const struct pipe_draw_info *info,
 
    if (is_xenos(ctx->screen)) {
       fd2_xenos_invalidate_caches(ring);
+      /* and each vertex buffer exactly, as libxenon does on unlock */
+      struct fd_vertex_stateobj *vtx = ctx->vtx.vtx;
+      for (unsigned i = 0; vtx && i < vtx->num_elements; i++) {
+         struct pipe_vertex_buffer *vb = &ctx->vtx.vertexbuf.vb[vtx->pipe[i].vertex_buffer_index];
+         if (vb->buffer.resource) {
+            struct fd_bo *bo = fd_resource(vb->buffer.resource)->bo;
+            fd2_xenos_invalidate_bo(ring, bo, fd_bo_size(bo));
+         }
+      }
    } else {
       OUT_PKT0(ring, REG_A2XX_TC_CNTL_STATUS, 1);
       OUT_RING(ring, A2XX_TC_CNTL_STATUS_L2_INVALIDATE);
