diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c b/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
index 17972f0..53301c0 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
@@ -114,6 +114,22 @@ emit_gmem2mem_surf(struct fd_batch *batch, uint32_t base,
       OUT_RING(ring, 0); /* VGT_MIN_VTX_INDX */
       fd_draw(batch, ring, DI_PT_RECTLIST, IGNORE_VISIBILITY,
               DI_SRC_SEL_AUTO_INDEX, 3, 0, INDEX_SIZE_IGN, 0, 0, NULL);
+      /* as libxenon's Xe_ResolveInto: cache flush event, then flush the GPU's
+       * caches over the destination (COHER 0x03000100) and wait for it, or the
+       * resolved pixels may not have reached memory when the fence passes */
+      OUT_PKT3(ring, CP_EVENT_WRITE, 1);
+      OUT_RING(ring, CACHE_FLUSH);
+      OUT_PKT0(ring, XENOS_REG_COHER_STATUS_HOST, 1);
+      OUT_RING(ring, 0x03000100);
+      OUT_PKT0(ring, XENOS_REG_COHER_SIZE_HOST, 2);
+      OUT_RING(ring, fd_resource_slice(rsc, psurf->level)->size0);
+      OUT_RELOC(ring, rsc->bo, offset, 0, 0);   /* COHER_BASE_HOST */
+      OUT_PKT3(ring, CP_WAIT_REG_MEM, 5);
+      OUT_RING(ring, 0x00000003);
+      OUT_RING(ring, XENOS_REG_COHER_STATUS_HOST);
+      OUT_RING(ring, 0x00000000);
+      OUT_RING(ring, 0x80000000);
+      OUT_RING(ring, 0x00000008);
       return;
    }
 
