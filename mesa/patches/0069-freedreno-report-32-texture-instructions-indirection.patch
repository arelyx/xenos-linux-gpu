---
 src/gallium/drivers/freedreno/freedreno_screen.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/gallium/drivers/freedreno/freedreno_screen.c b/src/gallium/drivers/freedreno/freedreno_screen.c
index d658af1..11cf497 100644
--- a/src/gallium/drivers/freedreno/freedreno_screen.c
+++ b/src/gallium/drivers/freedreno/freedreno_screen.c
@@ -245,6 +245,9 @@ fd_init_shader_caps(struct fd_screen *screen)
       caps->max_alu_instructions =
       caps->max_tex_instructions =
       caps->max_tex_indirections = 16384;
+      /* Xenos: ir2 records at most 64 fetches per shader (fetch_info[]) */
+      if (is_xenos(screen))
+         caps->max_tex_instructions = caps->max_tex_indirections = 32;
 
       caps->max_control_flow_depth = 8; /* XXX */
 
