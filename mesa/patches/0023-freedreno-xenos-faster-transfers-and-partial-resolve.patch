+/* Xenos: the part of the (single, origin) bin a batch touched, in 8-pixel blocks.
+ * Restores and resolves only cover it: a resolve copies its rectangle to the same
+ * (x, y) in the destination (Xenia draw_util GetResolveInfo). */
+static void
+xenos_dirty_rect(struct fd_batch *batch, unsigned *x0, unsigned *y0, unsigned *x1, unsigned *y1)
+{
+   struct pipe_framebuffer_state *pfb = &batch->framebuffer;
+   const struct pipe_scissor_state *ms = &batch->max_scissor;
+   *x0 = 0; *y0 = 0; *x1 = pfb->width; *y1 = pfb->height;
+   if (!getenv("XENOS_FULL_RESOLVE") && ms->minx <= ms->maxx && ms->miny <= ms->maxy) {
+      *x0 = MIN2(ms->minx, pfb->width) & ~7u;
+      *y0 = MIN2(ms->miny, pfb->height) & ~7u;
+      *x1 = MIN2(ms->maxx + 1u, (unsigned)pfb->width);
+      *y1 = MIN2(ms->maxy + 1u, (unsigned)pfb->height);
+   }
+   *x1 = MAX2(align(*x1, 8), *x0 + 8);
+   *y1 = MAX2(align(*y1, 8), *y0 + 8);
+}
