diff --git a/src/gallium/drivers/freedreno/a2xx/ir2.c b/src/gallium/drivers/freedreno/a2xx/ir2.c
index 98f1ca6..0fd8afc 100644
--- a/src/gallium/drivers/freedreno/a2xx/ir2.c
+++ b/src/gallium/drivers/freedreno/a2xx/ir2.c
@@ -241,10 +241,21 @@ sched_next(struct ir2_context *ctx, struct ir2_sched_instr *sched)
          export = MIN2(export, export_buf(instr->alu.export));
    }
 
+   /* an export's ALLOC loses a0 (xsdk docs/HARDWARE.md, "Reads at a0"):
+    * no export between a MOVA and its relative read */
+   bool a0_pending = false;
+   ir2_foreach_instr (p, ctx) {
+      if (p->need_emit && p->dep >= 0 && !ctx->instr[p->dep].need_emit)
+         a0_pending = true;
+   }
+
    ir2_foreach_instr (instr, ctx) {
       if (!instr->need_emit)
          continue;
 
+      if (a0_pending && is_export(instr))
+         continue;
+
       /* dont mix exports */
       if (is_export(instr) && export_buf(instr->alu.export) != export)
          continue;
