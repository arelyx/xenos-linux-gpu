+			{0x0205, 0x00}, {0x021d, 0x40}, {0x0221, 0x02}, {0x0222, 0x2b},
+			{0x022f, 0x01}, {0x023e, 0x3f}, {0x02df, 0x10},
+		};
+		for (int i = 0; i < ARRAY_SIZE(regs); i++)
+			xenon_snd_i2c_write(regs[i][0], regs[i][1]);
+	}
 	xenon_smc_send_message(smc_snd);
 
