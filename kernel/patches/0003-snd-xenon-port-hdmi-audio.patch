+MODULE_PARM_DESC(hdmi, "Enable audio on the HDMI output (default: true)");
+
+/* SMC GPIO read-modify-write (libxenon xenon_gpio_control) */
+static void xenon_snd_gpio_control(int reg, u32 clear, u32 set)
+{
+	static const int r[] = {0x20, 0x24, 0x28, 0x30, 0x34, 0x38, 0x40, 0x44, 0x48};
+	void __iomem *base = ioremap(0x200ea001000, 0x1000);
+	u32 b = readl(base + r[reg]);
+
+	writel((b & ~clear) | set, base + r[reg]);
+	iounmap(base);
+}
+
+/* SMC I2C write (libxenon xenon_smc_i2c_write), the reply left unread */
+static void xenon_snd_i2c_write(u16 addr, u8 val)
+{
+	unsigned char buf[16] = {0};
+	int ddc = addr >= 0x1d0 && addr <= 0x1f5;
+
+	buf[0] = 0x11;
+	buf[1] = ddc ? 0x21 : 0x20;
+	buf[3] = (addr >= 0x200 ? 0x3d : 0x39) | 0x80;
+	buf[6] = addr & 0xff;
+	buf[7] = val;
+	xenon_smc_send_message(buf);
+	msleep(5);
+}
